# Terraform local data and state
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.json
.terraform.tfstate.lock.info
crash.log
crash.*.log

# Terraform variable files may contain credentials or private CIDRs
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example

# Terraform local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Credentials generated by google-github-actions/auth
gha-creds-*.json

# Local credentials and keys
.env
.env.*
!.env.example
*.pem
*.pub
*.key
id_rsa
id_ed25519

# Kubernetes secrets and local kubeconfig files
*secret*.yaml
*secret*.yml
*secrets*.yaml
*secrets*.yml
kubeconfig
kubeconfig.*
.kube/

# Bash/runtime output
*.log
tmp/
temp/

# Editors, OS files, and downloaded diagnostics
.idea/
.vscode/
.DS_Store
artifacts/
